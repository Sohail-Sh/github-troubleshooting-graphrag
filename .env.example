# Neo4j (compose.yaml uses the same credentials)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# GitHub API collector: a fine-grained token with public read access is enough.
# Without it you get 60 requests/hour and no GraphQL closing references (no "verified" links).
GITHUB_TOKEN=

# Embeddings: fastembed (BAAI/bge-small-en-v1.5, downloads ~130 MB once) or hashing (offline fallback)
EMBEDDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_PATH=./data/models

# Explanations: "none" = deterministic only; "anthropic" = Claude writes them from the evidence (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Match gate (see docs/EVALUATION.md before changing)
MIN_TERM_COVERAGE=0.5
MIN_VECTOR_SIMILARITY=0.80
